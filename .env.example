# ============================================================
# Smart Supply - Environment Configuration
# Copy to .env and fill in values. Never commit .env.
# ============================================================

# ---------- Database ----------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=smartsupply
POSTGRES_USER=smartsupply
POSTGRES_PASSWORD=changeme_dev_only
DATABASE_URL=postgres://smartsupply:changeme_dev_only@postgres:5432/smartsupply

# ---------- Redis ----------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# ---------- Kafka (Redpanda in dev) ----------
KAFKA_BROKERS=redpanda:9092
KAFKA_CLIENT_ID=smart-supply

# ---------- Backend ----------
BACKEND_PORT=4000
BACKEND_HOST=0.0.0.0
LOG_LEVEL=info
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# ---------- Frontend ----------
VITE_API_URL=http://localhost:4000
VITE_WS_URL=ws://localhost:4000/ws
# Optional - if absent, frontend uses Leaflet OSM fallback
VITE_MAPBOX_TOKEN=

# ---------- ML Services ----------
ML_FORECAST_URL=http://ml-forecast:8001
ML_OPTIMIZE_URL=http://ml-optimize:8002
ML_AGENT_URL=http://ml-agent:8003

# ---------- Anthropic API (ml-agent only) ----------
# Provide your own key. Never commit. ml-agent degrades gracefully if absent.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# ---------- Simulator ----------
SIM_EVENTS_PER_SEC=200
SIM_SHIPMENTS=50

# ---------- Observability ----------
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
OTEL_SERVICE_NAME=smart-supply
# Set true to skip telemetry init (useful in tests)
OTEL_DISABLED=false
